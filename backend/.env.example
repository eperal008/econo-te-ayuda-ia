# ─── Econo Te Ayuda IA — backend environment ───────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Server
PORT=3001

# PostgreSQL (local dev example; production = customer-owned Heroku Postgres)
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/econo_dev
# Set to "false" for local Postgres (no SSL); "true" for Heroku Postgres
PGSSL=false

# OpenAI (intent router, semantic/AI fallback, recipes, vision)
OPENAI_API_KEY=

# Google Cloud (Speech-to-Text + Text-to-Speech). Paste the full service-account JSON on one line.
GOOGLE_CREDENTIALS=

# Cloudinary (product / promo image uploads via admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin dashboard auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_API_KEY=

# Store scope (single store for v1; schema is multi-store ready)
DEFAULT_STORE_ID=ECONO-SIERRA-BAYAMON
